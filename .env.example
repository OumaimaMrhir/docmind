# Copiez ce fichier en .env puis renseignez vos clés.

# Fournisseur du LLM : openai | anthropic | extractive (sans clé, pour tester)
LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Embeddings : openai | hashing (local, sans clé)
EMBEDDING_PROVIDER=hashing

# Recherche
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# Optionnel : protège l'API avec l'en-tête X-API-Key
API_KEY=
